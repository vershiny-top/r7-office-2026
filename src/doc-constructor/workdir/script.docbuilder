s3588.GetRange("A2").SetFormula("=\"АРТ-\"&LEFT(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(Товары_исходные!A2,\"№\",\"\"),\"АРТ-\",\"\"),\"АРТ_\",\"\"),\"/\",\"-\"),3)");
s3588.GetRange("B2").SetFormula("=PROPER(TRIM(IFERROR(LEFT(Товары_исходные!B2,FIND(\"(\",Товары_исходные!B2)-1),Товары_исходные!B2)))");
s3588.GetRange("C2").SetFormula("=IFERROR(VLOOKUP(Товары_исходные!C2,'Справочники'!$A$2:$B$50,2,FALSE),Товары_исходные!C2)");
s3588.GetRange("D2").SetFormula("=PROPER(TRIM(Товары_исходные!D2))");
s3588.GetRange("E2").SetFormula("=IFERROR(VALUE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(Товары_исходные!E2,\" \",\"\"),\"руб.\",\"\"),\"руб\",\"\"),\",\",\".\")),0)");
