s33054.GetRange("G2").SetFormula("=IFERROR(IF(ISNUMBER(FIND(\".\",Клиенты_исходные!G2)),DATE(RIGHT(Клиенты_исходные!G2,4),MID(Клиенты_исходные!G2,4,2),LEFT(Клиенты_исходные!G2,2)),DATE(LEFT(Клиенты_исходные!G2,4),MID(Клиенты_исходные!G2,6,2),RIGHT(Клиенты_исходные!G2,2))),Клиенты_исходные!G2)");
