s33054.GetRange("A2").SetFormula("=Клиенты_исходные!A2");
s33054.GetRange("B2").SetFormula("=PROPER(TRIM(Клиенты_исходные!B2))");
s33054.GetRange("C2").SetFormula("=IFERROR(IF(ISNUMBER(FIND(\".\",Клиенты_исходные!C2)),DATE(RIGHT(Клиенты_исходные!C2,4),MID(Клиенты_исходные!C2,4,2),LEFT(Клиенты_исходные!C2,2)),DATE(LEFT(Клиенты_исходные!C2,4),MID(Клиенты_исходные!C2,6,2),RIGHT(Клиенты_исходные!C2,2))),Клиенты_исходные!C2)");
