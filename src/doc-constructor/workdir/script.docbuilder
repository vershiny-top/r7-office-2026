var s43065 = Api.AddSheet("Итоговый_отчет");
s43065.GetRange("A1").SetValue("Файл");
s43065.GetRange("B1").SetValue("Строк до");
s43065.GetRange("C1").SetValue("Строк после");
s43065.GetRange("D1").SetValue("Удалено дублей");
s43065.GetRange("A2").SetValue("Товары");
s43065.GetRange("B2").SetFormula("=COUNTA('Товары_исходные'!A:A)-1");
s43065.GetRange("C2").SetFormula("=COUNTA('Товары_очищенные'!A:A)-1");
s43065.GetRange("D2").SetFormula("=B2-C2");
s43065.GetRange("A3").SetValue("Поставщики");
s43065.GetRange("B3").SetFormula("=COUNTA('Поставщики_исходные'!A:A)-1");
s43065.GetRange("C3").SetFormula("=COUNTA('Поставщики_очищенные'!A:A)-1");
s43065.GetRange("D3").SetFormula("=B3-C3");
s43065.GetRange("A4").SetValue("Продажи");
s43065.GetRange("B4").SetFormula("=COUNTA('Продажи_исходные'!A:A)-1");
s43065.GetRange("C4").SetFormula("=COUNTA('Продажи_очищенные'!A:A)-1");
s43065.GetRange("D4").SetFormula("=B4-C4");
s43065.GetRange("A5").SetValue("Клиенты");
s43065.GetRange("B5").SetFormula("=COUNTA('Клиенты_исходные'!A:A)-1");
s43065.GetRange("C5").SetFormula("=COUNTA('Клиенты_очищенные'!A:A)-1");
s43065.GetRange("D5").SetFormula("=B5-C5");
s43065.GetRange("A7").SetValue("Ошибки по типам");
s43065.GetRange("B7").SetValue("Кол-во");
s43065.GetRange("A8").SetValue("Ошибка ИНН");
s43065.GetRange("B8").SetFormula("=COUNTIF('Поставщики_очищенные'!J:J,\"Ошибка ИНН\")");
s43065.GetRange("A9").SetValue("Ошибка Email (поставщики)");
s43065.GetRange("B9").SetFormula("=COUNTIF('Поставщики_очищенные'!K:K,\"Ошибка Email\")");
s43065.GetRange("A10").SetValue("Ошибка Email (клиенты)");
s43065.GetRange("B10").SetFormula("=COUNTIF('Клиенты_очищенные'!J:J,\"Ошибка Email\")");
s43065.GetRange("A11").SetValue("Ошибка даты рождения");
s43065.GetRange("B11").SetFormula("=COUNTIF('Клиенты_очищенные'!I:I,\"Ошибка даты рождения\")");
s43065.GetRange("A12").SetValue("Розница ниже закупки");
